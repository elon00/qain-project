# --- EVM / wallet ---
RPC_URL=https://polygon-rpc.com
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_WITHOUT_QUOTES

# --- Nitrolite contract addresses (examples) ---
# Look up latest 'custody' and 'adjudicator' addresses in Nitrolite deployments.
CUSTODY=0x...
ADJUDICATOR=0x...

# a token to lock in the channel (e.g., USDC on Polygon) – or POL for native flows if supported by your app logic
TOKEN=0x...

# optional: your counterparty “guest” address if you pre-know it; else leave blank and set at runtime
GUEST=0x...

# Yellow ClearNode websocket (official)
CLEAR_NODE_WS=wss://clearnet.yellow.com/ws
PORT=8787


